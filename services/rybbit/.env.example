# Copier en .env puis compléter. Générer chaque secret avec : openssl rand -hex 32

# URL publique du tableau de bord (doit correspondre au domaine de ./Caddyfile)
BASE_URL=https://analytics.eliott-roussille.fr

# Secret de session (Better Auth)
BETTER_AUTH_SECRET=

# Mots de passe internes (bases jamais exposées hors du réseau du projet)
CLICKHOUSE_PASSWORD=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# false le temps de créer le compte administrateur, puis true et redéployer
# (scripts/app-deploy.sh rybbit) : sinon n'importe qui peut s'inscrire.
DISABLE_SIGNUP=false

# Facultatif
DISABLE_TELEMETRY=true
# Carte du monde (jeton public Mapbox) ; vide = carte désactivée
MAPBOX_TOKEN=
# Processus Node du backend (upstream : 4)
CLUSTER_WORKERS=2
# Version des images ghcr.io/rybbit-io/rybbit-{backend,client}
RYBBIT_VERSION=v2.9.0
