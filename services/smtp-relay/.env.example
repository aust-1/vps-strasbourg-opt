# Copier en .env puis compléter. Pas de Caddyfile : ce service n'a aucune route publique.

# Clé API Resend (resend.com → API Keys → « Sending access », restreinte au domaine ci-dessous).
# Une clé dédiée au relais, distincte de celle de bourse-tracker : révocable séparément.
RELAYHOST_PASSWORD=

# Domaine(s) expéditeur(s) autorisé(s), séparés par des espaces : DOIT être vérifié dans Resend,
# sinon Resend refuse l'envoi. Adresse d'expédition conseillée : noreply@eliott-roussille.fr
ALLOWED_SENDER_DOMAINS=eliott-roussille.fr

# Facultatif : autre fournisseur gratuit (Brevo : [smtp-relay.brevo.com]:587, identifiant = login
# SMTP du compte ; Mailjet : [in-v3.mailjet.com]:587, identifiant = clé API).
RELAYHOST=[smtp.resend.com]:587
RELAYHOST_USERNAME=resend
