# Copier en .env puis compléter. Pas de Caddyfile : ce service n'a aucune route publique.

# Clé API Resend (resend.com → API Keys → « Sending access », restreinte au domaine ci-dessous).
# Une clé dédiée au relais, distincte de celle de bourse-tracker : révocable séparément.
RELAYHOST_PASSWORD=

# Un compte par service qui envoie des emails : « nom@eliott-roussille.fr:motdepasse », séparés
# par des virgules, sans espace. Mot de passe : openssl rand -hex 24 (pas de « , » ni de « : »).
# Chaque service se connecte à smtp-relay:587, sans TLS, avec SON identifiant (traçable dans
# les journaux) ; retirer un compte puis redéployer lui coupe l'accès.
SMTPD_SASL_USERS=uptime-kuma@eliott-roussille.fr:

# Domaine(s) expéditeur(s) autorisé(s), séparés par des espaces : DOIT être vérifié chez le
# fournisseur, sinon il refuse l'envoi. Adresse d'expédition : noreply@eliott-roussille.fr
ALLOWED_SENDER_DOMAINS=eliott-roussille.fr

# Facultatif : autre fournisseur gratuit (Brevo : [smtp-relay.brevo.com]:587, identifiant = login
# SMTP du compte ; Mailjet : [in-v3.mailjet.com]:587, identifiant = clé API).
RELAYHOST=[smtp.resend.com]:587
RELAYHOST_USERNAME=resend
